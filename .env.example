# ---------------------------------------------------------------------------
# FRONTEND env (Vite). Copy to `.env` and fill in.
# Only PUBLIC values may live here - anything prefixed VITE_ is visible in the
# browser. NEVER put DeepSeek / SMTP secrets in this file (see server/.env).
# ---------------------------------------------------------------------------

# Google Maps JavaScript API key (public by design - restrict it by HTTP
# referrer to your domain + localhost, and by API to "Maps JavaScript API").
# Leave empty to show the elegant static map fallback.
VITE_GOOGLE_MAPS_API_KEY=
