# ---------------------------------------------------------------------------
# SERVER env (Express API). Copy to `server/.env` and fill in.
# These are SECRETS - never commit this file, never expose it to the browser.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=5174
# Comma-separated list of origins allowed to call the API (CORS).
# Dev: the Vite dev + preview servers. Prod: add https://rnbservices.online
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Set to true to make the Express server also serve the built React app (dist/)
# so the whole site runs on one Node host.
SERVE_STATIC=false

# --- DeepSeek (RNB Bot) ---------------------------------------------------
# Get a key at https://platform.deepseek.com  - set a monthly spend cap there.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Email (Nodemailer / SMTP) -------------------------------------------
# Easiest: a Gmail account with 2-step verification + an App Password
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true
# Alternative: Resend (SMTP_HOST=smtp.resend.com, SMTP_USER=resend, SMTP_PASS=<api key>)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# "From" address used for outgoing mail. Defaults to SMTP_USER if empty.
MAIL_FROM=
# Where enquiries are delivered (the client's inbox).
CLIENT_EMAIL=

# Testing aid: when true, enquiries are NOT emailed - they are logged (without
# secrets) and the API reports success. Leave false in production.
EMAIL_DRY_RUN=false

# --- Contact info the bot may share (optional) ---------------------------
# WhatsApp number in international format, digits only (e.g. 233200000000)
WHATSAPP_NUMBER=
