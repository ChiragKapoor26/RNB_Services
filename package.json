{
  "name": "rnb-services-online",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "R&B Services Online - marketing + enquiry website (React + Vite + Tailwind) with a small Express API.",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,yellow \"vite\" \"npm run dev:server\"",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts",
    "build": "npm run typecheck && vite build && npm run build:server",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=esm --packages=external --target=node20 --outfile=server/dist/index.js",
    "start": "node server/dist/index.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "photos": "tsx scripts/sync-photos.ts",
    "image-todo": "tsx scripts/image-todo.ts",
    "bot:test": "tsx server/scripts/test-bot.ts",
    "logos": "tsx scripts/process-logos.ts"
  },
  "dependencies": {
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@vis.gl/react-google-maps": "^1.10.2",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "framer-motion": "^14.14.0",
    "gsap": "^3.15.1",
    "helmet": "^8.3.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.74.0",
    "nodemailer": "^10.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.18.5",
    "three": "^0.172.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
